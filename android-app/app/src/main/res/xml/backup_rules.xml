<?xml version="1.0" encoding="utf-8"?><!--
   APU legacy backup rules (API < 31).
   M8-C: encrypted relay custody и wrapped at-rest ключ исключены из backup —
   они привязаны к Keystore этого устройства; на другом устройстве это мусор.
   См. data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="file" path="apu_relay.sqlite" />
    <exclude domain="file" path="apu_relay.sqlite-wal" />
    <exclude domain="file" path="apu_relay.sqlite-shm" />
    <exclude domain="sharedpref" path="apu_relay_at_rest.xml" />
</full-backup-content>
