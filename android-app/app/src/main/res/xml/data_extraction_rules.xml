<?xml version="1.0" encoding="utf-8"?><!--
   APU backup/transfer rules.
   M8-C: encrypted relay custody И at-rest ключевой материал сознательно
   исключены из backup/transfer:
   - apu_relay.sqlite* зашифрован device-bound ключом (Android Keystore);
     на новом устройстве этот ключ отсутствует, восстановленные байты были бы
     мусором → честнее начать с пустого custody (quarantine не создаётся).
   - apu_relay_at_rest.xml содержит wrapped master secret; без Keystore-ключа
     целевого устройства он бесполезен (unwrap невозможен); свежий secret
     генерируется на месте.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="apu_relay.sqlite" />
        <exclude domain="file" path="apu_relay.sqlite-wal" />
        <exclude domain="file" path="apu_relay.sqlite-shm" />
        <exclude domain="sharedpref" path="apu_relay_at_rest.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="apu_relay.sqlite" />
        <exclude domain="file" path="apu_relay.sqlite-wal" />
        <exclude domain="file" path="apu_relay.sqlite-shm" />
        <exclude domain="sharedpref" path="apu_relay_at_rest.xml" />
    </device-transfer>
</data-extraction-rules>
