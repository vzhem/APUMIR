<?xml version="1.0" encoding="utf-8"?><!--
   APU deliberately does not restore application data.

   Identity/session state and encrypted relay custody are device-bound. Restoring
   Room chats or p2p_prefs without the original Android Keystore entries produces
   a stale identity that skips onboarding and cannot be trusted. This was observed
   on a clean v11.16.19 install on Anna. Exclude every eligible data domain for
   both cloud backup and device transfer; AndroidManifest also sets allowBackup=false.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
