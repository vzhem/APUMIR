<?xml version="1.0" encoding="utf-8"?>
<!--
    Адаптивная иконка (Android 8+): система сама вырезает форму — круг, «сквиркл»,
    квадрат со скруглением, — поэтому знак лежит отдельным слоем, а не готовой
    картинкой с формой.

    Слои:
      • background — ровная ночь #010B1F (цвет дизайн-системы приложения);
      • foreground — золотой пузырь с ядром и серверами, вписанный в 66% полотна:
        это безопасная зона адаптивных иконок, за её край ничего важного не выходит.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
