<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Сеть -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- «Поделиться координатами»: разрешение спрашиваем только по нажатию кнопки метки -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14+: основной сервис держит постоянную доставку сообщений и
         должен работать круглосуточно. Тип dataSync для этого не годится:
         Android 15 ограничивает его 6 часами за сутки и запрещает запуск из
         BOOT_COMPLETED (docs/AUDIT_2026-10-26.md, P0-1). dataSync остаётся
         в манифесте для версий ниже 34, где specialUse ещё не существует. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- WakeLock -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Звонки: микрофон, звуковой фокус, полноэкранный входящий -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Батарея -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Раунд 141: аварийный каркас уведомлений - будить сервис каждые
         5 минут даже после убийства процесса и перезагрузки телефона.
         USE_EXACT_ALARM - точный будильник на Android 13+; точный на 12
         (SCHEDULE_EXACT_ALARM) и неточный запасной - в коде приёмника. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Уведомления (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MessengerApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.P2PMessenger"
        tools:targetApi="31">

        <!-- Hilt workers must use the application's factory, not WorkManager's reflection factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" tools:node="remove" />
        </provider>

        <!-- configChanges: поворот экрана обрабатывает само приложение. Без
             этого Android пересоздаёт активность, и человек вылетает на
             стартовую страницу, теряя открытый чат. Compose сам перестраивает
             разметку под новую ширину. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection"
            android:resizeableActivity="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.P2PMessenger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link для share links: https://t.me/p2p_messenger_relay_bot?start=NODE_ID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="t.me"
                      android:pathPrefix="/p2p_messenger_relay_bot" />
            </intent-filter>
            
            <!-- Signed referral HTTPS link. autoVerify becomes authoritative only after
                 apumir.app publishes the matching /.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="apumir.app"
                      android:pathPrefix="/i" />
                <!-- Короткая ссылка /s/<код> (data/link/ShortLinks.kt). -->
                <data android:pathPrefix="/s/" />
            </intent-filter>

            <!-- Пересланная ссылка на канал или пост: её отдаёт наш сервис.
                 Если APU установлен, Android откроет приложение сразу на
                 записи; если нет - откроется страница с установкой.

                 autoVerify: при установке Android скачивает с этого хоста
                 /.well-known/assetlinks.json (его отдаёт worker, см.
                 tools/worker/p2p_relay_worker.js) и, если отпечаток ключа
                 подписи совпал, открывает ссылку в APU БЕЗ вопроса. Без
                 проверки Android 12+ уводит https-ссылку в браузер. Хост здесь
                 и в GroupInviteLinks.WEB_HOST один и тот же - менять вместе. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="p2p-relay.apu.workers.dev"
                      android:pathPrefix="/i" />
                <!-- Короткая ссылка /s/<код>: путь нарочно другой, чем /i,
                     чтобы старые версии APU (они знают только /i) отдавали её
                     браузеру, а страница сервиса уже вела их в приложение
                     полной ссылкой. -->
                <data android:pathPrefix="/s/" />
            </intent-filter>

            <!-- HTTP схема (fallback) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http"
                      android:host="t.me"
                      android:pathPrefix="/p2p_messenger_relay_bot" />
            </intent-filter>
            
            <!-- Кастомная схема (самый надёжный вариант) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="p2pmessenger"
                      android:host="add" />
            </intent-filter>

            <!-- Короткая ссылка-приглашение: apu://a/<узел>/<никнейм>.
                 Основной вид с версии 11.38: втрое короче прежней, поэтому
                 QR-код выходит крупноклеточным и читается быстрее. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apu" android:host="a" />
                <data android:scheme="apu" android:host="u" />
            </intent-filter>

            <!-- Ссылка-приглашение в группу: p2pmessenger://group?slug=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="p2pmessenger"
                      android:host="group" />
            </intent-filter>

            <!-- Короткая форма той же ссылки: p2p://group/<slug> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="p2p"
                      android:host="group" />
            </intent-filter>

        </activity>

        <!-- Foreground Service.
             Тип объявлен двумя флагами осознанно: на Android 14+ сервис
             входит в foreground с явным типом specialUse (постоянная
             доставка сообщений), а на Android 10-13 — с dataSync, потому
             что тип specialUse появился только в API 34. Явный тип при
             каждом старте передаёт ServiceCompat.startForeground()
             (см. CoreServerService.enterForeground), поэтому «лишний» флаг
             манифеста не активируется и лимит dataSync не применяется. -->
        <service
            android:name=".service.CoreServerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent peer-to-peer message delivery" />
        </service>

        <!-- Сервис идущего звонка: держатель типа microphone для микрофона в фоне -->
        <service
            android:name=".service.CallService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />

        <!-- «Отклонить» с уведомления входящего звонка (явный broadcast). -->
        <receiver
            android:name=".data.call.IncomingCallReceiver"
            android:exported="false" />


        <receiver
            android:name=".service.NetworkChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Каркас доставки «как в Telegram»: будильник поднимает службу, если
             её убили, а приёмник возвращает цепочку после перезагрузки и
             обновления приложения. exported=true обязателен: системные
             широковещательные сообщения приходят снаружи приложения; сам
             приёмник сверяет действие с allowlist (EmergencyKeepAliveReceiver.isOwnAction)
             и больше ничего не делает, поэтому чужой вызов безвреден.
             LOCKED_BOOT_COMPLETED намеренно не слушаем: до первой
             разблокировки телефон закрывает личность и настройки, и службе
             нечего расшифровывать — доставка начинается с BOOT_COMPLETED. -->
        <receiver
            android:name=".service.EmergencyKeepAliveReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- После обновления приложения будильники сбрасываются: без
                     этого действия доставка молчала бы до первого открытия. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider для установки APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>